{
  "expo": {
    "name": "grao",
    "slug": "grao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "grao",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#241708"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hass1985.grao",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "O Grão usa o microfone para você contar seu momento falando, em vez de escrever.",
        "NSPhotoLibraryUsageDescription": "O Grão usa suas fotos apenas para você escolher uma imagem de perfil."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#241708",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hass1985.grao",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Grão",
      "shortName": "Grão",
      "lang": "pt-BR",
      "themeColor": "#241708",
      "backgroundColor": "#241708",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Grão usa suas fotos apenas para você escolher uma imagem de perfil."
        }
      ],
      "expo-audio",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "151ffb9e-9053-4947-9b63-ef8e951a13bf"
      }
    }
  }
}
