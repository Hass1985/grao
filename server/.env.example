# Copie para .env (que está no .gitignore) e preencha. NUNCA versione a chave real.

# ── Obrigatórias ────────────────────────────────────────────────────────────
# Chave da Claude API. Gere em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL. Local: postgres://grao:grao@localhost:5432/grao
# Supabase: Project Settings → Database → Connection string → "Session pooler"
DATABASE_URL=postgres://grao:grao@localhost:5432/grao

# ── Opcionais ───────────────────────────────────────────────────────────────
PORT=8787

# Modelos. O da Abertura roda 1x por usuário (vale o mais capaz);
# o do cérebro roda a cada mensagem (modelo pequeno + cache = centavos).
GRAO_MODEL=claude-opus-4-8
GRAO_OPENING_MODEL=claude-opus-4-8
GRAO_BRAIN_MODEL=claude-haiku-4-5-20251001

# Em produção, restrinja quem pode chamar a API (separe por vírgula).
# Ex.: https://dapper-smakager-388102.netlify.app
CORS_ORIGINS=

# SSL do Postgres: automático (ligado fora de localhost). Force com true/false.
# PGSSL=true

# Canal WhatsApp (consumido pelo n8n). Sem esta variável os endpoints
# /whatsapp/* respondem 503 — falham fechados de propósito.
GRAO_API_TOKEN=

# ── Meta / WhatsApp Cloud API ───────────────────────────────────────────────
# SEGREDOS (grave com: bash scripts/set-secret.sh NOME)
WA_ACCESS_TOKEN=
WA_APP_SECRET=
# Token do handshake do webhook. Não é alto risco (a segurança real é a
# assinatura HMAC), mas gere um valor aleatório: bash scripts/set-secret.sh WA_VERIFY_TOKEN
WA_VERIFY_TOKEN=
# IDs (não são segredo, pode preencher à mão)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Opcionais: nome e idioma do template aprovado (padrão semente_do_dia / pt_BR)
# WA_TEMPLATE_NAME=
# WA_TEMPLATE_LANG=
