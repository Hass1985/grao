{
  "name": "grao-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend do Grão — conversa generativa (Claude API) + perfil + entrega de sementes",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql && psql \"$DATABASE_URL\" -f db/seed_data.sql",
    "eval:opening": "tsx scripts/eval-opening.ts",
    "content:migrate": "tsx scripts/apply-sql.ts db/migrations/002_content.sql db/passage_pool.sql",
    "content:bible": "tsx scripts/import-bible.ts && tsx scripts/apply-sql.ts db/bible_corrections.sql",
    "content:musics": "tsx scripts/import-musics.ts",
    "content:generate": "tsx scripts/generate-seeds.ts",
    "content:review": "tsx scripts/review-seeds.ts",
    "content:audit": "tsx scripts/audit-drafts.ts",
    "content:regen": "tsx scripts/regenerate-flagged.ts",
    "content:check": "tsx scripts/check-drafts.ts",
    "content:repair": "tsx scripts/repair-drafts.ts",
    "content:variety": "tsx scripts/variety-report.ts",
    "content:validate-pool": "tsx scripts/validate-pool.ts",
    "content:page": "tsx scripts/review-page.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:password": "bash scripts/set-db-password.sh",
    "content:similarity": "tsx scripts/build-similarity.ts",
    "content:gestures": "tsx scripts/label-gestures.ts",
    "content:simulate": "tsx scripts/simulate-year.ts",
    "wa:check": "tsx scripts/check-wa.ts",
    "api:token": "bash scripts/set-api-token.sh",
    "content:backup": "tsx scripts/backup-seeds.ts",
    "funil": "tsx scripts/funil.ts",
    "watch": "tsx scripts/watch.ts",
    "wa:preview": "tsx scripts/testar-preview.ts",
    "content:travessao": "tsx scripts/tirar-travessao.ts",
    "acesso": "tsx scripts/acesso.ts",
    "content:devocional": "tsx scripts/import-devocional.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
